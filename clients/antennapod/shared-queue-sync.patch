+    public static Future<Boolean> setQueueForSync(final List<FeedItem> queue, final List<Long> expectedIds) {
+        return dbExec.submit(() -> {
+            List<Long> currentIds = new ArrayList<>();
+            for (FeedItem item : DBReader.getQueue()) {
+                currentIds.add(item.getId());
+            }
+            if (!currentIds.equals(expectedIds)) {
+                return false;
+            }
+            PodDBAdapter adapter = PodDBAdapter.getInstance();
+            adapter.open();
+            try {
+                adapter.setQueue(queue);
+            } finally {
+                adapter.close();
+            }
+            List<Long> storedIds = new ArrayList<>();
+            List<Long> wantedIds = new ArrayList<>();
+            for (FeedItem item : DBReader.getQueue()) {
+                storedIds.add(item.getId());
+            }
+            for (FeedItem item : queue) {
+                wantedIds.add(item.getId());
+            }
+            if (!storedIds.equals(wantedIds)) {
+                throw new IllegalStateException("Queue database update did not persist");
+            }
+            EventBus.getDefault().post(QueueEvent.setQueue(queue));
+            return true;
+        });
+    }
